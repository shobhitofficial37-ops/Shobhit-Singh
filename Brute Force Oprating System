log_lines = [
    "Failed password for invalid user admin from 192.168.1.50",
    "Failed password for invalid user admin from 192.168.1.50",
    "Failed password for invalid user admin from 192.168.1.50",
    "Failed password for invalid user admin from 192.168.1.50",
    "Failed password for invalid user admin from 192.168.1.50",
    "Failed password for invalid user admin from 192.168.1.50",
    "Accepted password for user root from 10.0.0.5",
    "Failed password for root from 203.0.113.5",
]

LIMIT = 5
seen_ips = []
fail_counts = []

for line in log_lines:

    if "Failed password" in line:

        words = line.split()
        ip_address = words[-1]  

        if ip_address in seen_ips:
            position = seen_ips.index(ip_address)
            fail_counts[position] = fail_counts[position] + 1
        else:
            seen_ips.append(ip_address)
            fail_counts.append(1)

print("----- Login Attempt Report -----")
print("")

position = 0
while position < len(seen_ips):
    ip_address = seen_ips[position]
    count = fail_counts[position]

    print("IP Address:", ip_address)
    print("Failed Attempts:", count)

    if count >= LIMIT:
        print("Risk Level: HIGH - possible brute-force attack!")
    else:
        print("Risk Level: Low")

    print("")
    position = position + 1

print("Report complete.")
